{
  "name": "krome",
  "version": "0.1.0",
  "description": "Native blockchain apps with Tauri, Svelte 5, Tevm and Helios",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "pnpm check",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "test:e2e:contracts": "vitest run -c vitest.e2e.config.ts",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "contracts:deploy": "KROME_DEPLOY=1 vite-node -c vitest.config.ts contracts/deploy.ts",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/svelte-query": "^5.90.2",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tevm": "1.0.0-next.149",
    "viem": "^2.58.4",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.12.6",
    "@tevm/ts-plugin": "1.0.0-next.148",
    "@types/node": "^22.20.5",
    "fast-check": "^4.11.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~5.7.3",
    "vite": "^6.4.6",
    "vite-node": "3.0.6",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  }
}
